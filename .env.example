# ---------------------------------------------------------------------------
# Environment variables for cfbchurch
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# Airtable — powers events, sermons, ministries, leadership, and the contact form.
# Personal access token from https://airtable.com/create/tokens
# NOTE: This is exposed to the browser via the NEXT_PUBLIC_ prefix, so scope the
# token to the minimum required (read-only where possible) for this one base.
NEXT_PUBLIC_AIRTABLE_API_TOKEN=your_airtable_personal_access_token

# The Airtable base ID (starts with "app..."), found in the base's API docs URL.
NEXT_PUBLIC_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
